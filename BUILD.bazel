# ── wac composition — plug the five leaves into the cascade ───────
# The cascade is the socket (imports five interfaces); each leaf is a
# plug (exports one). wac matches imports to exports by interface.
wac_plug(
    name = "falcon-cascade-composed",
    # v1.4 — the composed cascade now plugs the VERIFIED IEKF (falcon-iekf)
    # into the ekf socket instead of the v0.6 Mahony falcon-ekf. The verified
    # stack is the composed stack.
    plugs = [
        ":falcon-iekf",
        ":falcon-position",
        ":falcon-attitude",
        ":falcon-rate",
        ":falcon-mixer",
    ],
    socket = ":falcon-cascade",
)

# ── meld → synth: lower the cascade to an ARM Cortex-M ELF ────────
# meld_fuse resolves the cascade's five imports against the leaf
# exports into one single-memory core module; synth_compile AOT-
# compiles that to a Cortex-M7 ELF (the STM32H743 of
# renode/falcon-cortex-m.resc). This is the v0.7 equivalent of the
# v0.6 meld→wasm-opt→synth pipeline, now fully inside Bazel.
meld_fuse(
    name = "falcon-cascade-fused",
    components = [
        ":falcon-ekf",
        ":falcon-position",
        ":falcon-attitude",
        ":falcon-rate",
        ":falcon-mixer",
        ":falcon-cascade",
    ],
)

synth_compile(
    name = "falcon-cascade-firmware",
    target = "cortex-m7",
    wasm_module = ":falcon-cascade-fused",
)

# v0.13: witness MC/DC coverage on the fused cascade core module.
# v0.15.1: WASI gap closed via host/witness-wasi-harness.
# v0.16.0: bazel/wasm_module_coverage_wasi.bzl macro defined to
#   wrap witness instrument → run --harness → lcov in one Bazel
#   action graph. Not yet APPLIED here because the harness binary
#   (host/witness-wasi-harness) isn't a Bazel rust_binary target
#   — its dep tree (wasmtime, wasmtime-wasi, tokio) needs
#   rules_rust crate-universe setup this workspace doesn't carry
#   today. cargo-built recipe in FV-FALCON-COV-004 still applies.
#
# Closes DO-178C A-7.5 / A-7.6 (FV-FALCON-COV-001 / 004 / 005).
# Real-component MC/DC via the WASI subprocess harness (//host/witness-wasi-harness,
# now a real rust_binary — the #145 harness blocker is CLOSED). Still manual: the
# bundled `witness instrument` fails to parse the fused cascade's COMPONENT-model
# binary ("failed to parse export section") — witness expects a core module, the
# fused output is a component. Remaining blocker (deeper than the harness): target
# the pre-fusion core module, or bump the witness version in rules_wasm_component.
wasm_module_coverage_wasi(
    name = "falcon-cascade-coverage",
    module = ":falcon-cascade-fused",
    tags = ["manual"],
)

