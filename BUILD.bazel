wit_library(
    name = "falcon_mixer_wit",
    srcs = ["wit/falcon-cascade/cascade.wit"],
    package_name = "falcon:cascade",
    world = "mixer-component",
)

wit_library(
    name = "falcon_cascade_wit",
    srcs = ["wit/falcon-cascade/cascade.wit"],
    package_name = "falcon:cascade",
    world = "cascade",
)

# ── control-crate libraries — the verified relay-* control logic ──
# Wrap crates/relay-*/plain/src/lib.rs as Bazel rust_library targets so
# the leaf CM components can depend on them. relay-ekf / relay-pos route
# their no_std transcendentals through the :relay-math seam (#157); relay-math
# is the sole @libm_crate consumer (see MODULE.bazel).

rust_library(
    name = "relay-ekf",
    srcs = glob(["crates/relay-ekf/plain/src/**/*.rs"]),
    edition = "2024",
    # v1.x: transcendentals via the relay-math seam (mirrors Cargo.toml). (#157)
    deps = [":relay-math"],
)

# v1.12 — the flight-math qualification seam. relay-iekf / relay-mix-quad route
# their transcendentals through this single boundary instead of @libm_crate
# directly, so qualifying (or replacing) libm in the flight path is a one-crate
# change. The seam itself is the only libm consumer in the verified cascade.
rust_library(
    name = "relay-math",
    srcs = glob(["crates/relay-math/src/**/*.rs"]),
    edition = "2024",
    deps = ["@libm_crate//:libm"],
)

# v1.4 — the VERIFIED Invariant-EKF as a bazel rust_library, so it can be
# wrapped as the `falcon-iekf` Component Model component (replacing the v0.6
# Mahony cascade with the verified stack). v1.12: transcendentals via the
# relay-math seam.
rust_library(
    name = "relay-iekf",
    srcs = glob(["crates/relay-iekf/plain/src/**/*.rs"]),
    edition = "2024",
    deps = [":relay-math"],
)

rust_library(
    name = "relay-pos",
    srcs = glob(["crates/relay-pos/plain/src/**/*.rs"]),
    edition = "2024",
    # v1.x: transcendentals via the relay-math seam (mirrors Cargo.toml). (#157)
    deps = [":relay-math"],
)

rust_library(
    name = "relay-att",
    srcs = glob(["crates/relay-att/plain/src/**/*.rs"]),
    edition = "2024",
)

rust_library(
    name = "relay-rate",
    srcs = glob(["crates/relay-rate/plain/src/**/*.rs"]),
    edition = "2024",
)

rust_library(
    name = "relay-mix-quad",
    srcs = glob(["crates/relay-mix-quad/plain/src/**/*.rs"]),
    edition = "2024",
    # v0.34 MixerN::from_geometry uses sinf/cosf (no_std); v1.12 routes them
    # through the relay-math qualification seam. Mirrors the Cargo.toml dep;
    # the bazel build needs it declared explicitly.
    deps = [":relay-math"],
)

# ── leaf CM components — one WIT interface each ───────────────────
# rust_wasm_component_bindgen generates a `<name>_bindings` crate
# (e.g. falcon_ekf_bindings); wasm/cm/*/src/lib.rs aliases it back to
# `bindings` so the cargo-component-shaped source compiles unchanged.

rust_wasm_component_bindgen(
    name = "falcon-ekf",
    crate_features = ["bazel-bindings"],
    srcs = ["wasm/cm/ekf/src/lib.rs"],
    wit = ":falcon_ekf_wit",
    deps = [":relay-ekf"],
    profiles = ["release"],
)

# v1.4 — the verified IEKF exports the SAME falcon:cascade/ekf interface, so
