# ═══════════════════════════════════════════════════════════════
# Falcon v0.7 — control cascade as Component Model components
#
# wit/falcon-cascade/cascade.wit declares five leaf interfaces
# (ekf, position, attitude, rate, mixer) and a `cascade` world that
# imports all five and exports `step`. One wit_library per world;
# rust_wasm_component_bindgen generates per-world bindings; wac_plug
# composes the cascade socket against the five leaf plugs.
#
# The six rust_wasm_component_bindgen targets + wac_plug land once
# the control-crate dependency approach is settled (see the v0.7
# notes) — the wasm/cm/* leaf components depend on the relay-ekf /
# relay-pos / relay-att / relay-rate / relay-mix-quad crates, which
# do not yet have Bazel targets.
# ═══════════════════════════════════════════════════════════════

wit_library(
    name = "falcon_ekf_wit",
    srcs = ["wit/falcon-cascade/cascade.wit"],
    package_name = "falcon:cascade",
    world = "ekf-component",
)

wit_library(
    name = "falcon_position_wit",
    srcs = ["wit/falcon-cascade/cascade.wit"],
    package_name = "falcon:cascade",
    world = "position-component",
)

wit_library(
    name = "falcon_attitude_wit",
    srcs = ["wit/falcon-cascade/cascade.wit"],
    package_name = "falcon:cascade",
    world = "attitude-component",
)

wit_library(
    name = "falcon_rate_wit",
    srcs = ["wit/falcon-cascade/cascade.wit"],
    package_name = "falcon:cascade",
    world = "rate-component",
