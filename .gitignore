# Rust build artifacts
target/

# Bazel
bazel-*
# bazel-* is for the output symlinks; it also matches this composite action.
!/.github/actions/bazel-lock-check/
*.rlib

# Editor
.idea/
.vscode/
*.swp
*~

# OS
.DS_Store
Thumbs.db
# Cargo.lock is NOT ignored anywhere: every workspace's lock is committed,
# built with --locked, and audited (.github/workflows/lockfiles.yml). Until
# 2026-11-20 nested locks were ignored, and three host harnesses sat on a
# wasmtime with 24 advisories each because nothing pinned or audited them.

# Claude Code session-local settings
.claude/

# cargo-component-generated WIT bindings under wasm/cm — superseded by
# Bazel's rust_wasm_component_bindgen (bindings are generated at build
# time; the lib.rs files alias the generated crate).
wasm/cm/*/src/bindings.rs
coverage.lcov

# Bazel vendored external deps (Lean toolchain + Mathlib oleans, multi-GB;
# regeneratable via proofs/lean/vendor.sh — see proofs/lean/README.md)
/vendor/bazel/

# embedded cortex-m build artifacts
embedded/falcon-cortex-m/target/
target/falcon-pipeline/
/dist/
crates/*/src/bindings.rs

# Python bytecode from running scripts/ locally (recurring status noise).
__pycache__/
*.pyc
