# Rust build artifacts
target/

# Bazel
bazel-*
*.rlib

# Editor
.idea/
.vscode/
*.swp
*~

# OS
.DS_Store
Thumbs.db
Cargo.lock
# ...except the workspace-root lockfile (v1.54 / F8): tracked + built with
# --locked so a dependency cannot silently drift the build (the recurring
# proptest-pin drift). Nested crate lockfiles stay ignored.
!/Cargo.lock
# ...and the crate_universe manifest lockfile, which must be committed so the
# Bazel build (and Bazel CI) is reproducible.
!crates/relay-sch/wasm/Cargo.lock

# Claude Code session-local settings
.claude/

# cargo-component-generated WIT bindings under wasm/cm — superseded by
# Bazel's rust_wasm_component_bindgen (bindings are generated at build
# time; the lib.rs files alias the generated crate).
wasm/cm/*/src/bindings.rs
coverage.lcov

# Bazel vendored external deps (Lean toolchain + Mathlib oleans, multi-GB;
# regeneratable via proofs/lean/vendor.sh — see proofs/lean/README.md)
/vendor/bazel/

# embedded cortex-m build artifacts
embedded/falcon-cortex-m/target/
target/falcon-pipeline/
/dist/
