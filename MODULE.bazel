# The four sibling PulseEngine rules repos are pinned by git_override at an
# exact commit (relay#717). They were local_path_overrides of ../rules_*,
# which CI checked out at each repo's default-branch head, so the module graph
# moved without any change in relay and MODULE.bazel.lock could not be
# enforced. With the pins, `common --lockfile_mode=error` in .bazelrc holds:
# a graph change must come with a committed MODULE.bazel.lock.
# Bump a pin: edit `commit`, run `bazel mod deps --lockfile_mode=update`,
# commit both files. Develop against a local checkout without editing this file:
#   bazel build --override_module=rules_wasm_component=../rules_wasm_component ...

git_override(
    module_name = "rules_wasm_component",
    remote = "https://github.com/pulseengine/rules_wasm_component.git",
    commit = "0a743a3fd249febf2aeba96602bdb10ac066b0db",  # origin/main 2026-11-28: wit-bindgen async-spawn on @crates (#777)
)

bazel_dep(name = "rules_verus", version = "0.1.0")
git_override(
    module_name = "rules_verus",
    remote = "https://github.com/pulseengine/rules_verus.git",
    commit = "b492aba7fa02952c7dc478f6a1e48dce1d4cf3b0",  # origin/main 2026-11-21
)

bazel_dep(name = "rules_rocq_rust", version = "0.1.0")
git_override(
    module_name = "rules_rocq_rust",
    remote = "https://github.com/pulseengine/rules_rocq_rust.git",
    commit = "b4a9d1cf50024d349febeb374ef4ea3d8f538c6c",  # origin/main 2026-11-21
)

bazel_dep(name = "rules_lean", version = "0.1.0")
git_override(
    module_name = "rules_lean",
    remote = "https://github.com/pulseengine/rules_lean.git",
    commit = "4f1d283311b6d72d3f25d0b4aaabad4424b2b506",  # origin/main 2026-11-21
)

# Lean 4 toolchain + Mathlib. Version MUST match rules_lean's own
# MODULE.bazel pins (lean.toolchain 4.29.1 + lean.mathlib v4.29.1): the
# extension collects tags from all modules, and rules_lean's mathlib tag
# (v4.29.1) is what creates the @mathlib repo. A mismatched toolchain here
# (the prior 4.27.0) made Mathlib v4.29.1 demand a toolchain switch that
# needs Elan mid-build → "lake update failed". Keep this aligned with
# rules_lean. (Pinned + reproducible — see proofs/lean/README.md.)
lean = use_extension("@rules_lean//lean:extensions.bzl", "lean")
lean.toolchain(
    version = "4.29.1",
    # 4.29.1 is newer than the registry rules_lean 0.1.0's baked-in hash
    # table (which ships only 4.27.0), so any rules_lean without 4.29.1 in
    # its table must be given the verified per-platform hashes explicitly
    # or it fails `require_hashes`. Values
    # copied verbatim from rules_lean's own _KNOWN_VERSIONS["4.29.1"].
    sha256 = {
        "darwin_aarch64": "73bccb392ca7d8ab3d62a1e328bb7d057815f088dbdbfb6574f194ae505797af",
        "darwin_x86_64": "3585ab34d20c53cf915169aa5c0d2efbd9993a78b9dc08516641510eef08fab0",
        "linux_x86_64": "bf062d29556d655685fb287563c249ad6a8fde34352c18b5e32568a595c1aec1",
        "linux_aarch64": "1ccdfb7f924901f4b73a4b4eb169e5b3dc74f6836521b47e733ea25f2abfc0dc",
    },
)
use_repo(lean, "lean_toolchains", "mathlib")
register_toolchains("@lean_toolchains//:all")

# Rocq 9.0 toolchain — Nix-backed, hermetic (Coq 9.0 + coqutil +
# hammer + smpl). The `rocq` extension self-provisions its own
# nixpkgs repo; the host only needs the `nix` binary on PATH.
# 9.0 is the version for which the extension wires the separate
# `rocq_stdlib` package — 9.1's stdlib path is not yet supported.
# Activates the //proofs/rocq:*_test targets in proof_tests.
rocq = use_extension("@rules_rocq_rust//rocq:extensions.bzl", "rocq")
rocq.toolchain(
    version = "9.0",
    strategy = "nix",
    with_rocq_of_rust_deps = True,
)
use_repo(
    rocq,
    "rocq_toolchains",
    "rocq_stdlib",
    "rocq_coqutil",
    "rocq_hammer",
    "rocq_hammer_tactics",
    "rocq_smpl",
    # Floating-point proof track (rules_rocq_rust#37/#41): the Gappa binary
    # (referenced by the gappa_proof rule) + the FP support libraries so the
    # kernel-checked rounding bounds — and the Coq-Interval approximation
    # bounds that follow — resolve. proofs/gappa/ consumes these.
    "rocq_gappa_bin",
    "rocq_flocq",
    "rocq_gappalib",
    "rocq_interval",
    "rocq_coquelicot",
    # Coq-Interval approximation-bound env (rules_rocq_rust#43, DD-003): a
    # coq_9_0.withPackages(...) composition resolving Interval's full closure
    # (mathcomp-boot/fingroup, hierarchy-builder, coq-elpi). The
    # rocq_interval_proof rule defaults to @rocq_interval_env//:coqc — without
    # this use_repo, proofs/rocq/sin_approx.v (MATHF32-P04) can't resolve
    # `Require Import Interval.Tactic`.
    "rocq_interval_env",
)
register_toolchains("@rocq_toolchains//:all")

# rocq-of-rust (the Rust → Rocq translator) and its Rust-nightly
# toolchain come inherited from rules_rocq_rust's own MODULE.bazel.
# rules_wasm_component 1.0.0 and rules_rocq_rust both build against
# rules_rust 0.70.0 — the old git_override (commit 6281d27, now an
# ancestor of 0.70.0) is no longer needed.

# Rust toolchain: 1.100.0, the fleet pin (rules_wasm_component registers the
