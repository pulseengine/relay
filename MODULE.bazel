# Rust crate dependencies. NOTE: this stays on `extension.bzl` (not the
# newer `extensions.bzl`) deliberately — Bazel identifies an extension
# by its .bzl path, so this keeps relay's `crate` extension distinct
# from rules_verus / rules_rocq_rust (which use `extensions.bzl`).
# Sharing the extension would collide on the `@crates` repo name.
crate = use_extension("@rules_rust//crate_universe:extension.bzl", "crate")
crate.from_cargo(
    name = "relay_crates",
    cargo_lockfile = "//crates/relay-sch/wasm:Cargo.lock",
    manifests = ["//crates/relay-sch/wasm:Cargo.toml"],
    supported_platform_triples = [
        "wasm32-wasip2",
        "aarch64-apple-darwin",
        "x86_64-apple-darwin",
        "x86_64-unknown-linux-gnu",
        "aarch64-unknown-linux-gnu",
    ],
)
use_repo(crate, "relay_crates", "crates")

# witness-wasi-harness host deps (wasmtime/wasmtime-wasi/tokio) — a SECOND
# crate_universe over the standalone host/witness-wasi-harness workspace, so the
# harness builds as a Bazel rust_binary (//host/witness-wasi-harness) that the
# WASI MC/DC coverage flow (bazel/wasm_module_coverage_wasi.bzl) invokes. Host
# triples only — this is a host tool, not a wasm module. Repin: CARGO_BAZEL_REPIN=1.
# Unblocks real-component MC/DC (#145), flipping //:falcon-cascade-coverage off manual.
crate.from_cargo(
    name = "harness_crates",
    cargo_lockfile = "//host/witness-wasi-harness:Cargo.lock",
    manifests = ["//host/witness-wasi-harness:Cargo.toml"],
    supported_platform_triples = [
        "aarch64-apple-darwin",
        "x86_64-apple-darwin",
        "x86_64-unknown-linux-gnu",
        "aarch64-unknown-linux-gnu",
    ],
)
use_repo(crate, "harness_crates")

# libm — no_std transcendentals for the falcon control crates
# (relay-ekf, relay-pos). Pulled straight from crates.io as an
# http_archive rather than through crate_universe. The sha256 is the
# Cargo.lock checksum for libm 0.2.16 (a lockfile checksum is the
# sha256 of the `.crate` tarball). libm is pure no_std Rust with no
# build script, so a single rust_library over src/ is the whole BUILD.
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "libm_crate",
    build_file_content = """\
load("@rules_rust//rust:defs.bzl", "rust_library")

rust_library(
    name = "libm",
    srcs = glob(["src/**/*.rs"]),
    edition = "2021",
    visibility = ["//visibility:public"],
)
""",
    sha256 = "b6d2cec3eae94f9f509c767b45932f1ada8350c4bdb85af2fcab4a3c14807981",
    strip_prefix = "libm-0.2.16",
    type = "tar.gz",
    urls = ["https://static.crates.io/crates/libm/libm-0.2.16.crate"],
)

# embedded-io / embedded-io-async — the UBX driver's async byte-source bounds.
# Same treatment as libm above (http_archive, not crate_universe): both are pure
# no_std with no build script, embedded-io has NO dependencies and
# embedded-io-async depends only on embedded-io, so a single rust_library over
# src/ is the whole BUILD. They are here because //:falcon-cascade needs
# falcon-core, falcon-core needs falcon-gnss-ubx, and that is the only crate in
# the closure with an out-of-repo dependency (#397). sha256 values are the
# Cargo.lock checksums, which are the sha256 of the .crate tarball.
http_archive(
    name = "embedded_io_crate",
    build_file_content = """\
load("@rules_rust//rust:defs.bzl", "rust_library")

rust_library(
    name = "embedded_io",
    srcs = glob(["src/**/*.rs"]),
    # lib.rs does `#![doc = include_str!("../README.md")]`, so the README has to
    # be in the sandbox or the crate does not compile at all.
    compile_data = ["README.md"],
    edition = "2021",
    visibility = ["//visibility:public"],
)
""",
    sha256 = "9eb1aa714776b75c7e67e1da744b81a129b3ff919c8712b5e1b32252c1f07cc7",
    strip_prefix = "embedded-io-0.7.1",
    type = "tar.gz",
    urls = ["https://static.crates.io/crates/embedded-io/embedded-io-0.7.1.crate"],
)

http_archive(
    name = "embedded_io_async_crate",
    build_file_content = """\
load("@rules_rust//rust:defs.bzl", "rust_library")

rust_library(
    name = "embedded_io_async",
    srcs = glob(["src/**/*.rs"]),
    compile_data = ["README.md"],
    edition = "2021",
    deps = ["@embedded_io_crate//:embedded_io"],
    visibility = ["//visibility:public"],
)
""",
    sha256 = "2564b9f813c544241430e147d8bc454815ef9ac998878d30cc3055449f7fd4c0",
    strip_prefix = "embedded-io-async-0.7.0",
    type = "tar.gz",
    urls = ["https://static.crates.io/crates/embedded-io-async/embedded-io-async-0.7.0.crate"],
)

# WASI WIT interfaces from rules_wasm_component
wasi_wit_ext = use_extension("@rules_wasm_component//wasm:extensions.bzl", "wasi_wit")
