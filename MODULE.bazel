module(
    name = "relay",
    version = "0.1.0",
)

bazel_dep(name = "rules_rust", version = "0.70.0")
bazel_dep(name = "rules_wasm_component", version = "1.0.0")
bazel_dep(name = "bazel_skylib", version = "1.9.0")
bazel_dep(name = "platforms", version = "1.0.0")

local_path_override(
    module_name = "rules_wasm_component",
    path = "../rules_wasm_component",
)

bazel_dep(name = "rules_verus", version = "0.1.0")
local_path_override(
    module_name = "rules_verus",
    path = "../rules_verus",
)

bazel_dep(name = "rules_rocq_rust", version = "0.1.0")
local_path_override(
    module_name = "rules_rocq_rust",
    path = "../rules_rocq_rust",
)

bazel_dep(name = "rules_lean", version = "0.1.0")
local_path_override(
    module_name = "rules_lean",
    path = "../rules_lean",
)

# Lean 4 toolchain + Mathlib. Version MUST match rules_lean's own
# MODULE.bazel pins (lean.toolchain 4.29.1 + lean.mathlib v4.29.1): the
# extension collects tags from all modules, and rules_lean's mathlib tag
# (v4.29.1) is what creates the @mathlib repo. A mismatched toolchain here
# (the prior 4.27.0) made Mathlib v4.29.1 demand a toolchain switch that
# needs Elan mid-build → "lake update failed". Keep this aligned with
# rules_lean. (Pinned + reproducible — see proofs/lean/README.md.)
lean = use_extension("@rules_lean//lean:extensions.bzl", "lean")
lean.toolchain(
    version = "4.29.1",
    # 4.29.1 is newer than the registry rules_lean 0.1.0's baked-in hash
    # table (which ships only 4.27.0), so CI — which uses the *registry*
    # rules_lean, not the local_path_override — must be given the verified
    # per-platform hashes explicitly or it fails `require_hashes`. Values
    # copied verbatim from rules_lean's own _KNOWN_VERSIONS["4.29.1"].
    sha256 = {
        "darwin_aarch64": "73bccb392ca7d8ab3d62a1e328bb7d057815f088dbdbfb6574f194ae505797af",
        "darwin_x86_64": "3585ab34d20c53cf915169aa5c0d2efbd9993a78b9dc08516641510eef08fab0",
        "linux_x86_64": "bf062d29556d655685fb287563c249ad6a8fde34352c18b5e32568a595c1aec1",
        "linux_aarch64": "1ccdfb7f924901f4b73a4b4eb169e5b3dc74f6836521b47e733ea25f2abfc0dc",
    },
)
use_repo(lean, "lean_toolchains", "mathlib")
register_toolchains("@lean_toolchains//:all")

# Rocq 9.0 toolchain — Nix-backed, hermetic (Coq 9.0 + coqutil +
# hammer + smpl). The `rocq` extension self-provisions its own
# nixpkgs repo; the host only needs the `nix` binary on PATH.
# 9.0 is the version for which the extension wires the separate
# `rocq_stdlib` package — 9.1's stdlib path is not yet supported.
# Activates the //proofs/rocq:*_test targets in proof_tests.
rocq = use_extension("@rules_rocq_rust//rocq:extensions.bzl", "rocq")
rocq.toolchain(
    version = "9.0",
    strategy = "nix",
    with_rocq_of_rust_deps = True,
)
use_repo(
    rocq,
    "rocq_toolchains",
    "rocq_stdlib",
    "rocq_coqutil",
    "rocq_hammer",
    "rocq_hammer_tactics",
    "rocq_smpl",
)
register_toolchains("@rocq_toolchains//:all")

# rocq-of-rust (the Rust → Rocq translator) and its Rust-nightly
# toolchain come inherited from rules_rocq_rust's own MODULE.bazel.
# rules_wasm_component 1.0.0 and rules_rocq_rust both build against
# rules_rust 0.70.0 — the old git_override (commit 6281d27, now an
# ancestor of 0.70.0) is no longer needed.

# Rust crate dependencies. NOTE: this stays on `extension.bzl` (not the
# newer `extensions.bzl`) deliberately — Bazel identifies an extension
# by its .bzl path, so this keeps relay's `crate` extension distinct
# from rules_verus / rules_rocq_rust (which use `extensions.bzl`).
# Sharing the extension would collide on the `@crates` repo name.
crate = use_extension("@rules_rust//crate_universe:extension.bzl", "crate")
crate.from_cargo(
    name = "relay_crates",
    cargo_lockfile = "//crates/relay-sch/wasm:Cargo.lock",
    manifests = ["//crates/relay-sch/wasm:Cargo.toml"],
    supported_platform_triples = [
        "wasm32-wasip2",
        "aarch64-apple-darwin",
        "x86_64-apple-darwin",
        "x86_64-unknown-linux-gnu",
        "aarch64-unknown-linux-gnu",
    ],
)
use_repo(crate, "relay_crates", "crates")

# witness-wasi-harness host deps (wasmtime/wasmtime-wasi/tokio) — a SECOND
# crate_universe over the standalone host/witness-wasi-harness workspace, so the
# harness builds as a Bazel rust_binary (//host/witness-wasi-harness) that the
# WASI MC/DC coverage flow (bazel/wasm_module_coverage_wasi.bzl) invokes. Host
# triples only — this is a host tool, not a wasm module. Repin: CARGO_BAZEL_REPIN=1.
# Unblocks real-component MC/DC (#145), flipping //:falcon-cascade-coverage off manual.
crate.from_cargo(
    name = "harness_crates",
    cargo_lockfile = "//host/witness-wasi-harness:Cargo.lock",
    manifests = ["//host/witness-wasi-harness:Cargo.toml"],
    supported_platform_triples = [
        "aarch64-apple-darwin",
        "x86_64-apple-darwin",
        "x86_64-unknown-linux-gnu",
        "aarch64-unknown-linux-gnu",
    ],
)
use_repo(crate, "harness_crates")

# libm — no_std transcendentals for the falcon control crates
# (relay-ekf, relay-pos). Pulled straight from crates.io as an
# http_archive rather than through crate_universe. The sha256 is the
# Cargo.lock checksum for libm 0.2.16 (a lockfile checksum is the
# sha256 of the `.crate` tarball). libm is pure no_std Rust with no
# build script, so a single rust_library over src/ is the whole BUILD.
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "libm_crate",
    build_file_content = """\
load("@rules_rust//rust:defs.bzl", "rust_library")

rust_library(
    name = "libm",
    srcs = glob(["src/**/*.rs"]),
    edition = "2021",
    visibility = ["//visibility:public"],
)
""",
    sha256 = "b6d2cec3eae94f9f509c767b45932f1ada8350c4bdb85af2fcab4a3c14807981",
    strip_prefix = "libm-0.2.16",
    type = "tar.gz",
    urls = ["https://static.crates.io/crates/libm/libm-0.2.16.crate"],
)

# WASI WIT interfaces from rules_wasm_component
wasi_wit_ext = use_extension("@rules_wasm_component//wasm:extensions.bzl", "wasi_wit")
wasi_wit_ext.init()
use_repo(
    wasi_wit_ext,
    "wasi_cli",
    "wasi_clocks",
    "wasi_filesystem",
    "wasi_io",
    "wasi_random",
    "wasi_sockets",
)
