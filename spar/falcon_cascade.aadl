-- Falcon control cascade — the TWO-PARTITION architecture falcon-core flies.
--
-- RE-MODELLED 2026-10-21 (#587, maintainer decision). This package used to
-- describe five periodic threads — EKF, Position, Attitude, Rate, Mixer — at
-- 200 Hz on one STM32H743. That was the legacy five-stage decomposition #388
-- retired: falcon-core does NOT run five controllers. It runs ONE tick split
-- across TWO partitions, `EstimatorPartition` and `CascadePartition`
-- (`FlightCore { est, casc }`), and the deployment agreed for the first
-- vehicle (Pixhawk 6X-RT, i.MX RT1176; jess#144) places the estimator on the
-- Cortex-M4 and the cascade on the Cortex-M7.
--
-- RATE: 1 kHz on both partitions — SWREQ-FALCON-RATE-P01 / EKF-P01
-- ("1 ms on the target Cortex-M7") and `SUPERVISOR_CORE_LOOP_HZ = 1000.0`.
--
-- WCET IS UNMEASURED, and the budgets below say so rather than pretend.
-- Nobody has measured a falcon execution time on target (the WCET-leaf item of
-- the hardware bring-up register, #157). Each tick therefore carries the only
-- budget that is not an invention: its whole period, `0 ms .. 1 ms`. That keeps
-- the analysis honest in both directions — each core runs one tick thread, so
-- a full-period budget is schedulable on its own core and on nothing else, and
-- spar's sensitivity warning ("a 10% increase would exceed 100%") is the true
-- statement about a budget nobody has measured. When #157 provides numbers,
-- they replace these ranges; until then a green scheduling analysis here means
-- "the structure is schedulable if each tick fits its period", NOT "it fits".
--
-- The previous model's placeholder budgets (five threads x 0..1 ms at 5 ms) put
-- the H743 at 100% utilisation, already over the 74.3% RMA bound, and at 1 kHz
-- spar reported 500% with four missed deadlines. Those numbers were never
-- measured either; carrying them to 1 kHz would have meant inventing smaller
-- ones to make the analysis pass.
--
-- Data flow, per tick:
--
--     sensors -> [M4] estimator --nav state--> [M7] cascade -> motors
--                     ^                            |
--                     +------- in_flight ----------+   (one tick delayed)
--
-- The feedback edge is REAL and load-bearing: `CascadePartition::flying()`
-- feeds `EstimatorPartition::set_in_flight()`, because a multirotor
-- accelerometer reads specific force along the thrust axis, so fusing it as
-- gravity while airborne diverges the hold (#452). Modelling the split as
-- estimator -> cascade with nothing returning would describe a system that
-- does not fly. Found independently in the review of the split proposal (#575).
--
-- THE SUPERVISOR runs inside the cascade tick on the M7 — that is where the
-- published component hosts `FlightSupervisor` (SUPERVISOR-P01, #571). jess#144
-- also agreed a separate failsafe core (F100, gale); no falcon software is bound
-- to it today, so it is noted here rather than modelled as if it ran something.

package Falcon_Cascade
public
  with Falcon_Types;

  -- The one-bit feedback from the cascade back into the estimator's gravity
  -- gate. Local to this package so the shared Falcon_Types is untouched.
  data InFlight
  end InFlight;

  -- ══════════════════════════════════════════════════════════════
  -- Estimator partition — Cortex-M4
  -- ══════════════════════════════════════════════════════════════

  -- IEKF + every measurement update. Takes the host's sensor frame (control
  -- period + whatever aiding the tick carries) and publishes the navigation
  -- state — the only value that crosses to the cascade.
  thread EstimatorTick
    features
      sensors_in: in data port Falcon_Types::SensorFrame;
      in_flight_in: in data port InFlight;
      nav_out: out data port Falcon_Types::VehicleState;
    properties
      Dispatch_Protocol => Periodic;
      Period => 1 ms;
      Deadline => 1 ms;
      -- UNMEASURED (#157): the whole period, the only budget not invented.
      Compute_Execution_Time => 0 ms .. 1 ms;
      Priority => 10;
  end EstimatorTick;

  process EstimatorPartition
    features
      sensors_in: in data port Falcon_Types::SensorFrame;
      in_flight_in: in data port InFlight;
      nav_out: out data port Falcon_Types::VehicleState;
  end EstimatorPartition;

  process implementation EstimatorPartition.Iekf
    subcomponents
      est: thread EstimatorTick;
    connections
      e0: port sensors_in -> est.sensors_in;
      e1: port in_flight_in -> est.in_flight_in;
      e2: port est.nav_out -> nav_out;
  end EstimatorPartition.Iekf;

  -- ══════════════════════════════════════════════════════════════
  -- Cascade partition — Cortex-M7
  -- ══════════════════════════════════════════════════════════════

  -- Geometric SE(3) attitude + ADRC rate + mixer with rotor-out FDI + the
  -- altitude/position loops, with the FlightSupervisor (mode machine, failsafe
  -- arbiter, pre-arm table) wrapped around them.
  thread CascadeTick
    features
      nav_in: in data port Falcon_Types::VehicleState;
      waypoint_in: in data port Falcon_Types::Waypoint;
      pwm_out: out data port Falcon_Types::MotorPwm;
      in_flight_out: out data port InFlight;
    properties
      Dispatch_Protocol => Periodic;
      Period => 1 ms;
      Deadline => 1 ms;
      -- UNMEASURED (#157): the whole period, the only budget not invented.
      Compute_Execution_Time => 0 ms .. 1 ms;
      Priority => 10;
  end CascadeTick;

  process CascadePartition
    features
      nav_in: in data port Falcon_Types::VehicleState;
      waypoint_in: in data port Falcon_Types::Waypoint;
      pwm_out: out data port Falcon_Types::MotorPwm;
      in_flight_out: out data port InFlight;
  end CascadePartition;

  process implementation CascadePartition.Supervised
    subcomponents
      casc: thread CascadeTick;
    connections
      k0: port nav_in -> casc.nav_in;
      k1: port waypoint_in -> casc.waypoint_in;
      k2: port casc.pwm_out -> pwm_out;
      k3: port casc.in_flight_out -> in_flight_out;
  end CascadePartition.Supervised;
end Falcon_Cascade;
