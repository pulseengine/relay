package falcon:attitude-stream@0.1.0;

/// Attitude controller — stream transformer edition.
///
/// Takes a stream of attitude-loop inputs (attitude estimate quaternion +
/// attitude setpoint quaternion), emits a stream of body-rate setpoints.
/// Wraps the verified relay-att AttController. Self-contained types (does not
/// depend on the shared cascade.wit) — the third control-cascade engine as a
/// P3 async stream (#168 cascade arc).
interface attitude-stream {
    /// Attitude-loop input: the body-to-NED attitude estimate quaternion + the
    /// attitude setpoint quaternion + collective thrust (passed through).
    record att-input {
        qw: f32,
        qx: f32,
        qy: f32,
        qz: f32,
        sp-qw: f32,
        sp-qx: f32,
        sp-qy: f32,
        sp-qz: f32,
        thrust: f32,
    }

    /// Body-rate setpoint (rad/s) + collective thrust.
    record rate-setpoint {
        rx: f32,
        ry: f32,
        rz: f32,
        thrust: f32,
    }

    /// STREAM TRANSFORMER: attitude-loop inputs in → body-rate setpoints out.
    /// Each input drives the stateful attitude controller one step.
    monitor: func(inputs: stream<att-input>) -> stream<rate-setpoint>;
}

world attitude-stream-component {
    export attitude-stream;
}
