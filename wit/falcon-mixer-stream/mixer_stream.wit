package falcon:mixer-stream@0.1.0;

/// Quad mixer — stream transformer edition.
///
/// Takes a stream of torque setpoints, emits a stream of per-motor PWM.
/// Wraps the verified relay-mix-quad QuadMixer. Self-contained types (does not
/// depend on the shared cascade.wit) — the fifth and final control-cascade
/// engine as a P3 async stream (#168 cascade arc), the tail of the pipeline.
interface mixer-stream {
    /// Body-frame torque + collective thrust.
    record torque-setpoint {
        tx: f32,
        ty: f32,
        tz: f32,
        thrust: f32,
    }

    /// Per-motor PWM for a quad (normalised).
    record motor-pwm {
        m1: f32,
        m2: f32,
        m3: f32,
        m4: f32,
    }

    /// STREAM TRANSFORMER: torque setpoints in → motor PWM out.
    /// Each torque is mixed to the four motor commands.
    monitor: func(inputs: stream<torque-setpoint>) -> stream<motor-pwm>;
}

world mixer-stream-component {
    export mixer-stream;
}
