package pulseengine:falcon-cascade@0.8.0;

/// Falcon control cascade — Component Model edition.
///
/// Each controller is a typed component exporting one interface.
/// The `cascade` world imports all five and exports the top-level
/// `step`; `wac` wires the graph (falcon-cascade.wac). This is the
/// v0.7 rework: the v0.6 raw-`#[export_name]` scalar shortcut is
/// replaced by real Component Model components so the cascade
/// composes declaratively.
///
/// Records use flat f32 fields (not tuple<>) — the canonical ABI is
/// then a flat scalar list, which keeps both wac composition and the
/// eventual synth → ARM lowering simple.

interface types {
    /// EKF state estimate. quaternion is body-to-NED (w,x,y,z);
    /// position/velocity are NED metres / m·s⁻¹; body-rates wx/wy/wz
    /// are the gyro reading (rad/s) passed through for the rate loop.
    record vehicle-state {
        qw: f32, qx: f32, qy: f32, qz: f32,
        pos-n: f32, pos-e: f32, pos-d: f32,
        vel-n: f32, vel-e: f32, vel-d: f32,
        wx: f32, wy: f32, wz: f32,
        innovation: f32,
    }

    /// Raw IMU sample — body-frame accel (m/s²) + gyro (rad/s).
    record imu-sample {
        ax: f32, ay: f32, az: f32,
        gx: f32, gy: f32, gz: f32,
    }

    /// Attitude setpoint — body-to-NED quaternion + collective thrust.
    record attitude-setpoint {
        qw: f32, qx: f32, qy: f32, qz: f32,
        thrust: f32,
    }

    /// Body-rate setpoint (rad/s) + collective thrust.
    record rate-setpoint {
        rx: f32, ry: f32, rz: f32,
        thrust: f32,
    }

    /// Body-frame torque setpoint (N·m) + collective thrust.
    record torque-setpoint {
        tx: f32, ty: f32, tz: f32,
        thrust: f32,
    }

    /// Per-motor PWM for the falcon-quad airframe, each in [0, 1].
    record motor-pwm {
        m1: f32, m2: f32, m3: f32, m4: f32,
    }

    /// Mission waypoint — NED target position + heading.
    record waypoint {
        north: f32, east: f32, down: f32, yaw: f32,
    }

    /// A 3-vector; the frame is named by the field that uses it.
    record vec3 {
        x: f32, y: f32, z: f32,
    }

    /// Everything the estimator needs for ONE tick.
    ///
    /// v0.8 replaces the bare `imu-sample` argument, because v0.7 could not
    /// express either of two things a host must be able to say. Both were
    /// found by actually driving the published components from a host
    /// (tests/cascade-sitl-wasm) rather than by reading the interface.
    ///
    /// `dt-s` — the host's ACTUAL control period. v0.7 had no way to state it,
    /// so the estimator hardcoded 1 kHz; an off-rate host got a confidently
    /// wrong answer and no error at all. Measured against the SITL plant:
    ///     1000 Hz -> 0.00 m altitude error   (what it assumed)
    ///      400 Hz -> 10.43 m
    ///      250 Hz -> 27.17 m
    ///
    /// The optional aiding measurements — v0.7 took the IMU alone, so position
    /// was observable only by dead reckoning. Same plant, same IMU noise of
    /// 0.2 m/s^2: the native cascade (GNSS @5 Hz + mag + heading) held 0.39 m
    /// while the IMU-only wasm cascade inverted to -121 m.
    ///
    /// Every aiding field is `option<>`, and `none` reproduces v0.7 behaviour
    /// exactly — an IMU-only host stays valid, it just inherits the drift.
    ///
    /// Measurement variances are deliberately NOT in this record: they are
    /// tuned per-vehicle and live with the estimator, not with the host that
    /// happens to own the sensor driver.
    record sensor-frame {
        imu: imu-sample,
        dt-s: f32,
        /// NED position fix (m) — GNSS or equivalent. Fused when present.
        position-ned: option<vec3>,
        /// Body-frame magnetometer. Any consistent unit; normalised internally.
        mag-body: option<vec3>,
        /// Absolute heading (rad, NED). An alternative to `mag-body` for hosts
        /// that already resolve yaw; both correct the same unobservable state.
        heading-rad: option<f32>,
    }
}

/// State estimator — wraps relay-ekf (Mahony complementary filter).
interface ekf {
    use types.{sensor-frame, vehicle-state};
    /// One estimator step: propagate over `dt-s`, then fuse whichever aiding
    /// measurements the frame carries.
    estimate: func(sensors: sensor-frame) -> vehicle-state;
}

/// Position controller — wraps relay-pos.
interface position {
    use types.{vehicle-state, waypoint, attitude-setpoint};
    tick: func(state: vehicle-state, target: waypoint) -> attitude-setpoint;
}

/// Attitude controller — wraps relay-att.
interface attitude {
    use types.{vehicle-state, attitude-setpoint, rate-setpoint};
    tick: func(state: vehicle-state, sp: attitude-setpoint) -> rate-setpoint;
}

/// Rate controller — wraps relay-rate (body-rate PID).
interface rate {
    use types.{vehicle-state, rate-setpoint, torque-setpoint};
    tick: func(state: vehicle-state, sp: rate-setpoint) -> torque-setpoint;
}

/// Control allocator — wraps relay-mix-quad (X-config mixer).
interface mixer {
    use types.{torque-setpoint, motor-pwm};
    mix: func(torque: torque-setpoint) -> motor-pwm;
}

// ── leaf component worlds — one controller each ───────────────────
world ekf-component      { export ekf; }
world position-component { export position; }
world attitude-component { export attitude; }
world rate-component     { export rate; }
world mixer-component    { export mixer; }

// ── cascade orchestrator ──────────────────────────────────────────
/// Top-level cascade entry point. A single-func interface (rather
/// than a bare world-level export) so the cascade component is
/// structurally uniform with the five leaf components — and so the
/// wit-bindgen export macro is generated the same, interface-shaped
/// way the leaf components rely on.
interface controller {
    use types.{sensor-frame, waypoint, motor-pwm};
    /// One full cascade pass: estimate → position → attitude → rate
    /// → mixer. The frame carries the host's tick period and any aiding
    /// measurements it has this tick.
    step: func(sensors: sensor-frame, target: waypoint) -> motor-pwm;
}

/// Imports the five controller interfaces, exports `controller`.
/// The implementation calls estimate → position → attitude → rate
/// → mixer in order. wac satisfies the imports from the leaf
/// components (BUILD.bazel `wac_plug`).
world cascade {
    import ekf;
    import position;
    import attitude;
    import rate;
    import mixer;
    export controller;
}
