package falcon:position-stream@0.1.0;

/// Position controller — stream transformer edition.
///
/// Takes a stream of position-loop inputs (vehicle NED pos/vel + attitude
/// quaternion + the waypoint target), emits a stream of attitude setpoints.
/// Wraps the verified relay-pos PosController. Self-contained types (does not
/// depend on the shared cascade.wit) — the second control-cascade engine as a
/// P3 async stream (#168 cascade arc).
interface position-stream {
    /// Position-loop input: vehicle state (NED position m, NED velocity m/s,
    /// body-to-NED quaternion) + the waypoint target (NED metres + yaw rad).
    record pos-input {
        pos-n: f32,
        pos-e: f32,
        pos-d: f32,
        vel-n: f32,
        vel-e: f32,
        vel-d: f32,
        qw: f32,
        qx: f32,
        qy: f32,
        qz: f32,
        target-north: f32,
        target-east: f32,
        target-down: f32,
        target-yaw: f32,
    }

    /// Body-to-NED attitude setpoint + collective thrust.
    record attitude-setpoint {
        qw: f32,
        qx: f32,
        qy: f32,
        qz: f32,
        thrust: f32,
    }

    /// STREAM TRANSFORMER: position-loop inputs in → attitude setpoints out.
    /// Each input drives the stateful position controller one step.
    monitor: func(inputs: stream<pos-input>) -> stream<attitude-setpoint>;
}

world position-stream-component {
    export position-stream;
}
