# Lean 4 proofs: mathematical foundations for Relay engines
#
# These are PURE MATHEMATICAL proofs about timing, buffer sizing,
# and stream composition safety. They do not depend on any
# implementation code.
#
#   - WCET Analysis: worst-case execution time bounds per engine
#   - Backpressure Safety: bounded stream transformer composition

load("@rules_lean//lean:defs.bzl", "lean_library", "lean_proof_test")

# ── WCET Analysis ─────────────────────────────────────────────────────

lean_library(
    name = "wcet_analysis",
    srcs = ["WcetAnalysis.lean"],
    deps = ["@mathlib//:Mathlib"],
)

lean_proof_test(
    name = "wcet_analysis_test",
    srcs = ["WcetAnalysis.lean"],
    deps = [":wcet_analysis", "@mathlib//:Mathlib"],
)

# ── Backpressure Safety ───────────────────────────────────────────────

lean_library(
    name = "backpressure_safety",
    srcs = ["BackpressureSafety.lean"],
    deps = ["@mathlib//:Mathlib"],
)

lean_proof_test(
    name = "backpressure_safety_test",
    srcs = ["BackpressureSafety.lean"],
    deps = [":backpressure_safety", "@mathlib//:Mathlib"],
)

# ── Compositional WCET ────────────────────────────────────────────────
# The novel result: WCET of a pipeline = sum of stage WCETs + handoff.
# Connects the verified primitive bounds to the engine-level WCET in
# WcetAnalysis.lean, replacing magic constants with derived sums.

lean_library(
    name = "compositional_wcet",
    srcs = ["CompositionalWcet.lean"],
    deps = ["@mathlib//:Mathlib"],
)

lean_proof_test(
    name = "compositional_wcet_test",
    srcs = ["CompositionalWcet.lean"],
    deps = [":compositional_wcet", "@mathlib//:Mathlib"],
)

# ── Geometric SE(3) Lyapunov (v0.23) ──────────────────────────────────
# The algebraic core of geometric-controller stability: the closed-loop
# Lyapunov derivative collapses to −k_Ω‖ω‖² ≤ 0 (vanishing iff ω=0). The
# dynamic LaSalle step is cited (Lee 2010) pending Mathlib's stability API.
# Paired with the runnable numerical certificate in relay-geo.

lean_library(
    name = "geometric_lyapunov",
    srcs = ["GeometricLyapunov.lean"],
    deps = ["@mathlib//:Mathlib"],
)

lean_proof_test(
    name = "geometric_lyapunov_test",
    srcs = ["GeometricLyapunov.lean"],
    deps = [":geometric_lyapunov", "@mathlib//:Mathlib"],
)

# v0.38 — the TRANSLATIONAL half: the closed-loop position Lyapunov collapses
# to −k_v‖e_v‖² ≤ 0, and the FULL-STATE V̇ = −k_Ω‖ω‖² − k_v‖e_v‖² ≤ 0. Closes
# the simplex shield's attitude-only scope gap (position safety covered).

lean_library(
    name = "position_lyapunov",
    srcs = ["PositionLyapunov.lean"],
    deps = ["@mathlib//:Mathlib"],
)

lean_proof_test(
    name = "position_lyapunov_test",
    srcs = ["PositionLyapunov.lean"],
    deps = [":position_lyapunov", "@mathlib//:Mathlib"],
)

# ── Strict (cross-term) Lyapunov — exponential-decay inequality (v1.105) ──
# The negative-DEFINITE upgrade of the semidefinite V̇ ≤ 0 core: Sylvester's
# 2×2 criterion + assembly into c_hi·V̇ ≤ −c_D·V (Lee 2010 Prop. 2, algebraic
# core). This is the Grönwall hypothesis — it reduces the deferred dynamic
# step from "formalize LaSalle" (absent from Mathlib) to "apply Grönwall"
# (present). No sorry, no axiom.

lean_library(
    name = "strict_lyapunov",
    srcs = ["StrictLyapunov.lean"],
    deps = ["@mathlib//:Mathlib"],
)

lean_proof_test(
    name = "strict_lyapunov_test",
    srcs = ["StrictLyapunov.lean"],
    deps = [":strict_lyapunov", "@mathlib//:Mathlib"],
)
