# ── f32 sin approximation-error bound (MATHF32-P04, Coq-Interval) ─────────
# The minimax-remainder half of the sin error: |P(r) - sin r| <= 1e-8 over
# the reduced range, complementing the Gappa rounding bound in
# proofs/gappa/sin_poly_rounding.gappa. Uses the withPackages Interval env
# (rules_rocq_rust#43); the kernel-check is the point, the tactic is not
# trusted (CC-002).

rocq_interval_proof(
    name = "sin_approx",
    srcs = ["sin_approx.v"],
)

rocq_proof_test(
    name = "sin_approx_test",
    srcs = [],
    deps = [":sin_approx"],
)

# ── f32 cos approximation-error bound (MATHF32-P05, Coq-Interval) ────────
# The minimax-remainder half of the cos error: |Q(r) - cos r| <= 1e-9 over
# the reduced range, complementing the Gappa rounding bound in
# proofs/gappa/cos_poly_rounding.gappa. Cosine analogue of sin_approx.

rocq_interval_proof(
    name = "cos_approx",
    srcs = ["cos_approx.v"],
)

rocq_proof_test(
    name = "cos_approx_test",
    srcs = [],
    deps = [":cos_approx"],
)

# ── Kernel axiom audit (SWREQ-RELAY-LEDGER-P01, North Star O3) ────────────
# rocq_proof_test proves the kernel accepted each script; it does not prove the
# script is free of Admitted obligations or Axioms. Each test below runs Print
# Assumptions on every declaration of its library and fails on anything not in
# its allowed_axioms list, so a new axiom or an Admitted proof is red. The
# allowlist is the measured state on 2026-11-20 and may only shrink.

[rocq_assumptions_test(
    name = lib + "_assumptions_test",
    allowed_axioms = [],
    deps = [":" + lib],
) for lib in [
    "lc_proofs",
    "sch_proofs",
    "sc_proofs",
    "hs_proofs",
    "cfdp_proofs",
]]

# The Coq-Interval proofs (rocq_interval_proof) are audited since
# rules_rocq_rust#67. They cannot have an empty allowlist: Reals rests on 4
# classical axioms and Interval computes with primitive floats, whose
# operations are kernel axioms. The allowlist is the measured set in
# interval_trusted_base.bzl. Any other axiom, including an Admitted lemma
# (reported under its own name), fails the test.
[rocq_assumptions_test(
    name = p + "_assumptions_test",
    allowed_axioms = STDLIB_REAL_AXIOMS + KERNEL_PRIMITIVES,
    deps = [":" + p],
) for p in ["sin_approx", "cos_approx"]]
